# Development only. Generate fresh local values; never reuse these placeholders.
RELAYDESK_POSTGRES_PASSWORD=replace-with-random-value
RELAYDESK_MIGRATE_PASSWORD=replace-with-random-value
RELAYDESK_RUNTIME_PASSWORD=replace-with-random-value
RELAYDESK_APP_PASSWORD=replace-with-random-value
RELAYDESK_AUTH_PASSWORD=replace-with-random-value
RELAYDESK_MIGRATION_DATABASE_URL=postgres://relaydesk_migrate:replace-with-random-value@postgres:5432/relaydesk?sslmode=disable
RELAYDESK_DATABASE_URL=postgres://relaydesk_runtime:replace-with-random-value@postgres:5432/relaydesk?sslmode=disable
RELAYDESK_APP_DATABASE_URL=postgres://relaydesk_app:replace-with-random-value@postgres:5432/relaydesk?sslmode=disable
RELAYDESK_AUTH_DATABASE_URL=postgres://relaydesk_auth:replace-with-random-value@postgres:5432/relaydesk?sslmode=disable
RELAYDESK_ENCRYPTION_KEY_B64=replace-with-base64-encoded-32-byte-key
RELAYDESK_OIDC_CLIENT_SECRET=replace-with-random-value
RELAYDESK_DEV_OIDC_PASSWORD=replace-with-random-local-test-password
RELAYDESK_DEV_OIDC_HASH=replace-with-bcrypt-hash
# Fail closed after any restore; set true only after account and recovery checks.
RELAYDESK_OUTBOUND_EXECUTION_ENABLED=false
# Set these only for real test-provider execution in isolated Stage 0 environments.
RELAYDESK_PROVIDER_MODE=
RELAYDESK_HUBSPOT_CLIENT_ID=
RELAYDESK_HUBSPOT_CLIENT_SECRET=
RELAYDESK_SLACK_CLIENT_ID=
RELAYDESK_SLACK_CLIENT_SECRET=
